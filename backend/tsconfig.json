{
  "extends": "../tsconfig.json",
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["bun", "node"],
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["./src/*"]
    }
  }
}
