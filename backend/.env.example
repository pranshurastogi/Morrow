NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
PUBLIC_APP_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/morrow
REDIS_URL=redis://localhost:6379

R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=morrow-private
UPLOAD_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=15000000

OPENAI_API_KEY=replace_me
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_ESCALATION_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=low
# Lifetime, server-enforced model allowance for each authenticated account.
AI_USER_SPEND_LIMIT_USD=4
OCR_ENABLED=true
OCR_POOL_SIZE=2

# Shopify UCP catalogue discovery. The Shopify profile is a safe local-development
# fixture; production should point at this API's public /.well-known/ucp URL.
UCP_ENABLED=true
UCP_GLOBAL_CATALOG_URL=https://catalog.shopify.com/api/ucp/mcp
UCP_AGENT_PROFILE_URL=https://shopify.dev/ucp/agent-profiles/2026-04-08/valid-with-capabilities.json
UCP_REQUEST_TIMEOUT_MS=12000
UCP_MAX_PRODUCTS=12
UCP_MAX_MERCHANTS_PER_SCAN=6

PRAVA_API_URL=https://sandbox.api.prava.space
PRAVA_SECRET_KEY=sk_test_replace_after_rotation

# Generate with: openssl rand -base64 32
SESSION_TOKEN_ENCRYPTION_KEY=replace_with_base64_32_byte_key
ACCOUNT_DATA_ENCRYPTION_KEY=replace_with_a_different_base64_32_byte_key

# JWT provider. Local development may use the explicit development headers instead.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
ALLOW_DEVELOPMENT_AUTH=true

# Private, network-restricted adapter for the Prava Browser Harness or an approved merchant adapter.
MERCHANT_CHECKOUT_EXECUTOR_URL=
MERCHANT_CHECKOUT_EXECUTOR_SECRET=

ALLOW_ILLUSTRATIVE_OFFERS=false
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=morrow-backend
